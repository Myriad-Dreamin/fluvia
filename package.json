{
  "name": "fluvia",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Fully-async dataflow CLI: JS-syntax calls, resource handles, and completion notifications for LLM agents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Myriad-Dreamin/fluvia.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "cli": "node packages/cli/bin/fluvia.js cli",
    "serve": "node packages/cli/bin/fluvia.js serve",
    "connect": "node packages/cli/bin/fluvia.js connect",
    "demo": "node packages/cli/bin/fluvia.js demo",
    "demo-perf": "node packages/cli/bin/fluvia.js perf",
    "dsh-inbox": "node packages/cli/bin/fluvia.js dsh-inbox",
    "bench": "node packages/cli/bin/fluvia.js bench",
    "slice": "node packages/cli/bin/fluvia.js slice",
    "test": "pnpm test:boundary && pnpm --filter dsh-plugin-fluvia verify && pnpm --filter pi-web-fluvia verify",
    "test:boundary": "pnpm --filter @fluvia/cli test:boundary",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "site:build": "bash scripts/build-site.sh"
  },
  "devDependencies": {
    "@fluvia/cli": "workspace:^",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@12.4.2"
}
